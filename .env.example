# Server-side only. Copy the Auth URL from the Neon Auth configuration,
# not the PostgreSQL connection string. Never put secrets in NEXT_PUBLIC_*.
NEON_AUTH_BASE_URL=
# Generate a random value with at least 32 characters; keep it stable across deploys.
NEON_AUTH_COOKIE_SECRET=

# Stripe server-side configuration. Use test-mode values while developing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create a recurring Price in Stripe and paste its price_... ID here.
STRIPE_PRICE_ID=
# Public app origin, for example https://meal-prep-assistant-avinash-menon.vercel.app
APP_URL=http://localhost:3000
# Neon Postgres connection string for the app's billing table (not the Neon Auth URL).
DATABASE_URL=
