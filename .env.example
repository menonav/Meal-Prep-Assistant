# Server-side only. Copy the Auth URL from the Neon Auth configuration,
# not the PostgreSQL connection string. Never put secrets in NEXT_PUBLIC_*.
NEON_AUTH_BASE_URL=
# Generate a random value with at least 32 characters; keep it stable across deploys.
NEON_AUTH_COOKIE_SECRET=

# Neon Postgres connection string for account plans and paid access.
# Add the branch-specific value to each Vercel environment you use.
DATABASE_URL=

# Server-side AI secret. Create a key at platform.openai.com/api-keys.
OPENAI_API_KEY=
# Optional; defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Stripe test key + webhook signing secret; switch to live keys only when ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time premium price in USD cents (100 = $1.00).
STRIPE_PRICE_CENTS=100
